# PI-IOS UI 回归 · 机密与目标机参数模板
#
# 用法：
#   cp .env.example .env    # .env 已在 .gitignore 中（.env / .env.*），永不入库
#   编辑 .env 填入真实值；执行用例前在当前 shell 里加载：
#   set -a; . ./.env; set +a
#
# 规则：
#   1) 本文件只放键名与注释，任何真实主机、口令、令牌、API Key 都不写进仓库。
#   2) 截图、录屏、日志、异常记录里出现真实地址时，按 README §8 改写成 RFC 5737 保留地址。
#   3) 口令/私钥/令牌只在 shell 变量里流转，不要 `echo` 到终端（会进滚动缓冲与录屏）。

# ---------- 模拟器（口径 A） ----------
# `xcrun simctl list devices` 里的 UDID
PI_IOS_DEVICE_UDID=
PI_IOS_BUNDLE_ID=dev.piios.PI-IOS

# ---------- 真实服务器（口径 B） ----------
PI_IOS_SSH_HOST=
PI_IOS_SSH_PORT=22
PI_IOS_SSH_USER=
# password | key
PI_IOS_SSH_AUTH=key
PI_IOS_SSH_PASSWORD=
# 本机私钥文件路径（口径 B 的私钥认证用）
PI_IOS_SSH_KEY_PATH=
# pi-adaptor 在服务器 127.0.0.1 上监听的端口
PI_IOS_HOST_PORT=44271
# 服务器执行 `pi-adaptor --pair` 打印的一次性令牌（ppt2.…）
PI_IOS_PAIR_TOKEN=

# ---------- 模型服务（口径 B，用于真实对话用例） ----------
# deepseek | openai
PI_IOS_LLM_PRESET=deepseek
PI_IOS_LLM_BASE_URL=
PI_IOS_LLM_API_KEY=
PI_IOS_LLM_MODEL=

# ---------- 既有 XCTest 门禁（可选） ----------
# ProjectsLaunchUITests 用真实地址跑时，用它覆盖仓库里的保留地址
PI_IOS_EXPECTED_HOST=
# LiveDeepSeekChatUITests 门禁
PI_IOS_DEEPSEEK_CHAT=
